{
  "name": "studio-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Band rehearsal studio website with online booking and admin dashboard",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed:demo": "npm run seed:demo -w backend",
    "test": "node --test --test-concurrency=1",
    "check:env": "node deploy/check-env.mjs",
    "backup": "node deploy/backup.mjs",
    "backup:verify": "node deploy/verify-backup.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
