# Copy this file to .env and fill it in.

# Password for the staff admin at /admin. Change this before going live.
ADMIN_PASSWORD=TrueBeliever

# Signs admin login sessions. Use any long random string; keep it the same between restarts
# so staff stay logged in. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Port for the API (and the whole site in production)
PORT=4000

# Booking dates and hours are in this time zone
STUDIO_TZ=Asia/Manila

# Where the SQLite database file lives (default: ./data/studio.db)
# DB_PATH=./data/studio.db
