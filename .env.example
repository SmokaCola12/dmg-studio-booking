# Copy this file to .env and fill it in.

# Password for the staff admin at /admin. Change this before going live: outside "npm run dev" the server refuses to
# start while this is empty, still the placeholder below, "changeme", or shorter than 8 characters.
# Check the whole file at any time with:  npm run check:env   (it lists names only, never the values)
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs admin login sessions. Use any long random string; keep it the same between restarts
# so staff stay logged in. Use at least 32 characters (the server warns at startup otherwise). Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Port for the API (and the whole site in production)
PORT=4000

# Booking dates and hours are in this time zone
STUDIO_TZ=Asia/Manila

# Where the SQLite database file lives (default: ./data/studio.db)
# DB_PATH=./data/studio.db

# ---------- GCash payments (staff-confirmed, with a screenshot as proof) ----------

# Payment screenshots hold names and phone numbers, so they are stored in a private folder that is never served to the
# public. Back this folder up with the database. Default: ./data/private/receipts
# RECEIPT_DIR=./data/private/receipts

# Email to customers (payment confirmed, not received, hold expired) and to the studio inbox (new online booking, GCash
# receipt to check, customer cancelled or rescheduled). Leave SMTP_USER and SMTP_PASS empty to turn email off: everything
# still works, customers see the same updates under My booking and staff see everything in the admin.
# Studio emails go to SMTP_USER unless another address is set in the admin under Settings, where each one can also be
# switched off and a test email can be sent.
# For Gmail, turn on 2-Step Verification, then create an App Password (Google Account > Security > App passwords) and use
# it here. Do NOT use your normal Google password.
SMTP_USER=
SMTP_PASS=
# Sender shown to customers (default: SMTP_USER)
# MAIL_FROM=DMG Studio <you@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: the public address of the site (no trailing slash). Adds a link to My booking in customer emails and to
# the admin page in studio emails.
# PUBLIC_SITE_URL=https://example.com

# Optional limits (defaults shown): receipt uploads per IP per 15 minutes, and failed booking code + phone matches per IP
# per 15 minutes.
# UPLOAD_RATE_LIMIT=10
# LOOKUP_FAIL_LIMIT=30
# Test emails from the admin Settings page, for the whole server, per 10 minutes:
# TEST_EMAIL_RATE_LIMIT=5

# How many reverse proxies (Nginx, Caddy, a host's load balancer) sit in front of the server. The limits above are keyed
# by IP address, taken from the X-Forwarded-For header the proxy sets. Set this to the real number of proxies that
# overwrite that header: if it is higher than reality, a visitor can fake the header and dodge the limits. 0 = no proxy
# (the server is reached directly). Default: 1.
# TRUST_PROXY=1

# ---------- Backups (npm run backup) ----------

# Where backups are written (default: ./backups in the project folder). Use a full path, ideally on another disk.
# Never point it inside UPLOAD_DIR or frontend/dist: those folders are served to the public.
# BACKUP_DIR=D:\Backups\dmg-studio

# When set and 7-Zip is installed (7-zip.org), every backup is packed into an AES-256 encrypted .7z and the plain copy
# is deleted. Without it backups are NOT encrypted and hold customer names, phone numbers and payment receipts.
# Plain keyboard characters only. Keep a copy of this passphrase somewhere else: without it a backup cannot be opened.
# BACKUP_PASSPHRASE=
# Only needed when 7z.exe is not on PATH and not in C:\Program Files\7-Zip:
# SEVENZIP_PATH=C:\Tools\7-Zip\7z.exe
