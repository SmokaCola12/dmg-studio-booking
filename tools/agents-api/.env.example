# Copy to tools/agents-api/.env (git ignores it) and fill in.

# Token callers must send as "Authorization: Bearer <token>". If empty, a random one is printed at startup.
AGENTS_API_TOKEN=

# Used by the Claude Agent SDK to run the agents. Create a key at console.anthropic.com.
# Do not paste it into chat or commit it.
ANTHROPIC_API_KEY=

# Optional
# AGENTS_API_PORT=4800
# AGENTS_MAX_CONCURRENT=3
